<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>Durell.iOS</RootNamespace>
    <AssemblyName>DurellCollection</AssemblyName>
    <ApplicationId>uk.co.allthejohnsons.durellcollection</ApplicationId>
    <ApplicationTitle>Durell</ApplicationTitle>
    <ApplicationVersion>$(DurellBuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(DurellVersion)</ApplicationDisplayVersion>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignKey>$(DurellAppleDevIdentity)</CodesignKey>
    <CodesignProvision>devel-durell</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>$(DurellAppleDistIdentity)</CodesignKey>
    <CodesignProvision>rel-durell</CodesignProvision>
    <ArchiveOnBuild>false</ArchiveOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Durell.Core\Durell.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the logo on the launch screen (LaunchScreen.storyboard) -->
    <BundleResource Include="LaunchLogo.png" />
  </ItemGroup>
</Project>
