<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+ system splash: the app icon on the collection's dark blue, then the in-app splash -->
  <style name="Theme.Splash" parent="android:Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowSplashScreenBackground">#0A0D1F</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowBackground">@color/splash_background</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowNoTitle">true</item>
  </style>
  <style name="MainTheme">
    <!-- Set theme colors from https://aka.ms/material-colors -->
    <!-- colorPrimary is used for the default action bar background -->
    <!--<item name="colorPrimary">#2196F3</item>-->
    <!-- colorPrimaryDark is used for the status bar -->
    <!--<item name="colorPrimaryDark">#1976D2</item>-->
    <!-- colorAccent is used as the default value for colorControlActivated
         which is used to tint widgets -->
    <!--<item name="colorAccent">#FF4081</item>-->
  </style>
</resources>