<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Single source of truth for the release version on every platform. -->
    <DurellVersion>1.0.0</DurellVersion>
    <DurellBuildNumber>1</DurellBuildNumber>
    <Version>$(DurellVersion)</Version>
    <Company>Paul F. Johnson</Company>
    <Product>The Durell Collection</Product>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <MonoGameVersion>3.8.5.1</MonoGameVersion>
  </PropertyGroup>
  <!-- Signing identities live outside git (see build/apple.props.example). -->
  <Import Project="$(MSBuildThisFileDirectory)signing/apple.props" Condition="Exists('$(MSBuildThisFileDirectory)signing/apple.props')" />
</Project>
